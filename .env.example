# ==============================================================================
# MedExplain_AI — Environment Variables Example
# Target Budget: ₹0 (Free Tier Defaults)
# Copy this file to .env in the root or server directory for local development.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas Free Tier M0 or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/medexplain_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medexplain_ai

# Authentication Secrets
# Generate a strong 64-character secret using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration (Google AI Studio Free Tier)
# Get a free API key at: https://aistudio.google.com/
# If unconfigured, the platform operates in local/manual mode without AI extraction.
GEMINI_API_KEY=

# File Storage Provider: 'local' (default for ₹0 development) or 'supabase' (free tier cloud)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Optional: Supabase Storage Configuration (if STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_BUCKET_NAME=medical-reports

# Optional: Email Service Configuration (for production password reset emails)
# For local dev, a secure development console reset token mechanism is provided.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="MedExplain AI" <no-reply@medexplain.ai>
